// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int                @id @default(autoincrement())
  username          String             @db.VarChar(255)
  email             String             @unique @db.VarChar(255)
  password_hash     String             @db.VarChar(255)
  created_at        DateTime
  last_login        DateTime?
  is_active         Boolean
  phone_number      String?            @db.VarChar(20)
  social_login_type String?            @db.VarChar(50)
  
  // 관계 설정
  categoryPreferences UserCategoryPreference[]
  reviews            Review[]
  userMissions       UserMission[]
  userProfile        UserProfile?
  userBadges         UserBadge[]
  storeOwner         StoreOwner[]
  inquiries          Inquiry[]
  userPoints         UserPoint[]
  logs               Log[]
  
  @@map("USER")
}

model Category {
  id          Int                      @id @default(autoincrement())
  name        String                   @db.VarChar(100)
  description String?                  @db.VarChar(255)
  icon        String?                  @db.VarChar(255)
  is_active   Boolean
  
  // 관계 설정
  userPreferences UserCategoryPreference[]
  stores          Store[]
  
  @@map("CATEGORY")
}

model UserCategoryPreference {
  id          Int      @id @default(autoincrement())
  user_id     Int
  category_id Int
  created_at  DateTime
  
  // 관계 설정
  user        User     @relation(fields: [user_id], references: [id])
  category    Category @relation(fields: [category_id], references: [id])
  
  @@index([user_id])
  @@index([category_id])
  @@map("USER_CATEGORY_PREFERENCE")
}

model Store {
  id              Int           @id @default(autoincrement())
  region_id       Int
  category_id     Int
  name            String        @db.VarChar(255)
  description     String?       @db.Text
  address         String        @db.VarChar(255)
  contact_number  String?       @db.VarChar(20)
  latitude        Float?
  longitude       Float?
  business_hours  String?       @db.VarChar(255)
  main_image      String?       @db.VarChar(255)
  is_active       Boolean
  
  // 관계 설정
  region          Region        @relation(fields: [region_id], references: [id])
  category        Category      @relation(fields: [category_id], references: [id])
  storeOwners     StoreOwner[]
  storeImages     StoreImage[]
  storeInfo       StoreInfo?
  reviews         Review[]
  missions        Mission[]
  menus           Menu[]
  
  @@index([region_id])
  @@index([category_id])
  @@map("STORE")
}

model Region {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  description String?  @db.Text
  latitude    Float?
  longitude   Float?
  
  // 관계 설정
  stores      Store[]
  
  @@map("REGION")
}

model StoreOwner {
  id                      Int      @id @default(autoincrement())
  user_id                 Int
  store_id                Int
  registered_date         DateTime
  is_verified             Boolean
  business_license_number String?  @db.VarChar(50)
  
  // 관계 설정
  user                    User     @relation(fields: [user_id], references: [id])
  store                   Store    @relation(fields: [store_id], references: [id])
  
  @@index([user_id])
  @@index([store_id])
  @@map("STORE_OWNER")
}

model StoreImage {
  id            Int      @id @default(autoincrement())
  store_id      Int
  image_url     String   @db.VarChar(255)
  caption       String?  @db.VarChar(255)
  display_order Int
  uploaded_at   DateTime
  
  // 관계 설정
  store         Store    @relation(fields: [store_id], references: [id])
  
  @@index([store_id])
  @@map("STORE_IMAGE")
}

model StoreInfo {
  id                    Int      @id @default(autoincrement())
  store_id              Int      @unique
  detailed_description  String?  @db.Text
  last_updated          DateTime @default(now())
  
  // 관계 설정
  store                 Store    @relation(fields: [store_id], references: [id])
  
  @@map("STORE_INFO")
}

model Review {
  id             Int            @id @default(autoincrement())
  user_id        Int
  mission_id     Int?
  store_id       Int
  rating         Int
  content        String?        @db.Text
  created_at     DateTime
  updated_at     DateTime       @default(now())
  is_verified    Boolean
  helpful_count  Int
  
  // 관계 설정
  user           User           @relation(fields: [user_id], references: [id])
  mission        Mission?       @relation(fields: [mission_id], references: [id])
  store          Store          @relation(fields: [store_id], references: [id])
  reviewImages   ReviewImage[]
  reviewReplies  ReviewReply[]
  
  @@index([user_id])
  @@index([mission_id])
  @@index([store_id])
  @@map("REVIEW")
}

model ReviewImage {
  id            Int      @id @default(autoincrement())
  review_id     Int
  image_url     String   @db.VarChar(255)
  display_order Int
  uploaded_at   DateTime
  
  // 관계 설정
  review        Review   @relation(fields: [review_id], references: [id])
  
  @@index([review_id])
  @@map("REVIEW_IMAGE")
}

model ReviewReply {
  id          Int      @id @default(autoincrement())
  review_id   Int
  owner_id    Int
  content     String   @db.Text
  created_at  DateTime
  updated_at  DateTime @default(now())
  
  // 관계 설정
  review      Review   @relation(fields: [review_id], references: [id])
  
  @@index([review_id])
  @@index([owner_id])
  @@map("REVIEW_REPLY")
}

model Mission {
  id                Int           @id @default(autoincrement())
  store_id          Int
  title             String        @db.VarChar(255)
  description       String?       @db.Text
  reward_points     Int
  start_date        DateTime
  end_date          DateTime
  type              String?       @db.VarChar(50)
  is_active         Boolean
  difficulty_level  Int
  
  // 관계 설정
  store             Store         @relation(fields: [store_id], references: [id])
  userMissions      UserMission[]
  reviews           Review[]
  userPoints        UserPoint[]
  
  @@index([store_id])
  @@map("MISSION")
}

model UserMission {
  id              Int       @id @default(autoincrement())
  user_id         Int
  mission_id      Int
  assigned_date   DateTime
  completed_date  DateTime?
  status          String    @default("진행중") @db.VarChar(50)
  proof_image     String?   @db.VarChar(255)
  admin_comment   String?   @db.Text
  
  // 관계 설정
  user            User      @relation(fields: [user_id], references: [id])
  mission         Mission   @relation(fields: [mission_id], references: [id])
  
  @@index([user_id])
  @@index([mission_id])
  @@map("USER_MISSION")
}

model UserPoint {
  id          Int       @id @default(autoincrement())
  user_id     Int
  amount      Int
  type        String    @db.VarChar(50)
  description String?   @db.Text
  created_at  DateTime
  mission_id  Int?
  
  // 관계 설정
  user        User      @relation(fields: [user_id], references: [id])
  mission     Mission?  @relation(fields: [mission_id], references: [id])
  
  @@index([user_id])
  @@index([mission_id])
  @@map("USER_POINT")
}

model UserProfile {
  id             Int       @id @default(autoincrement())
  user_id        Int       @unique
  nickname       String    @db.VarChar(100)
  profile_image  String?   @db.VarChar(255)
  total_points   Int
  level          Int
  updated_at     DateTime  @default(now())
  
  // 관계 설정
  user           User      @relation(fields: [user_id], references: [id])
  
  @@map("USER_PROFILE")
}

model Badge {
  id              Int          @id @default(autoincrement())
  name            String       @db.VarChar(100)
  description     String?      @db.Text
  image           String?      @db.VarChar(255)
  required_points Int
  type            String?      @db.VarChar(50)
  
  // 관계 설정
  userBadges      UserBadge[]
  
  @@map("BADGE")
}

model UserBadge {
  id            Int      @id @default(autoincrement())
  user_id       Int
  badge_id      Int
  acquired_date DateTime
  
  // 관계 설정
  user          User     @relation(fields: [user_id], references: [id])
  badge         Badge    @relation(fields: [badge_id], references: [id])
  
  @@index([user_id])
  @@index([badge_id])
  @@map("USER_BADGE")
}

model Menu {
  id           Int      @id @default(autoincrement())
  store_id     Int
  name         String   @db.VarChar(255)
  description  String?  @db.Text
  price        Decimal  @db.Decimal(10, 2)
  is_available Boolean
  image_url    String?  @db.VarChar(255)
  
  // 관계 설정
  store        Store    @relation(fields: [store_id], references: [id])
  
  @@index([store_id])
  @@map("MENU")
}

model Inquiry {
  id                Int               @id @default(autoincrement())
  user_id           Int
  title             String            @db.VarChar(255)
  content           String            @db.Text
  created_at        DateTime
  status            String            @default("대기중") @db.VarChar(50)
  type              String?           @db.VarChar(50)
  
  // 관계 설정
  user              User              @relation(fields: [user_id], references: [id])
  inquiryResponses  InquiryResponse[]
  
  @@index([user_id])
  @@map("INQUIRY")
}

model InquiryResponse {
  id             Int      @id @default(autoincrement())
  inquiry_id     Int
  admin_id       Int
  content        String   @db.Text
  response_date  DateTime
  
  // 관계 설정
  inquiry        Inquiry  @relation(fields: [inquiry_id], references: [id])
  
  @@index([inquiry_id])
  @@index([admin_id])
  @@map("INQUIRY_RESPONSE")
}

model Log {
  id               Int       @id @default(autoincrement())
  user_id          Int?
  action_type      String    @db.VarChar(100)
  timestamp        DateTime
  ip_address       String?   @db.VarChar(45)
  additional_data  String?   @db.Text
  
  // 관계 설정
  user             User?     @relation(fields: [user_id], references: [id])
  
  @@index([user_id])
  @@map("LOG")
}